{
  "info": {
    "title": "Test",
    "version": "1.0.0"
  },
  "openapi": "3.1.1",
  "servers": [
    {
      "url": "https://api.example.com"
    }
  ],
  "paths": {
    "/cards": {
      "get": {
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Card"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Card": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "price": {
            "$ref": "#/components/schemas/Price"
          }
        },
        "required": [
          "id",
          "price"
        ]
      },
      "Price": {
        "type": "object",
        "properties": {
          "amount": {
            "type": "number"
          }
        },
        "required": [
          "amount"
        ]
      }
    }
  }
}