{
  "name": "@kamaalio/hono-standard-openapi",
  "version": "0.0.1",
  "description": "Generate OpenAPI documents from any Standard Schema library, for Hono.",
  "keywords": [
    "hono",
    "json-schema",
    "openapi",
    "standard-schema",
    "validator"
  ],
  "license": "MIT",
  "author": "",
  "repository": {
    "type": "git",
    "url": "https://github.com/kamaal111/hono-standard-openapi"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "compile": "tsc -p tsconfig.build.json",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "prepare": "husky",
    "release": "sh scripts/publish.sh",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/standard-validator": "^0.4.0",
    "openapi3-ts": "^4.5.0"
  },
  "devDependencies": {
    "@kamaal111/oxlint-plugin-anti-slop": "^0.0.3",
    "@oxlint/plugins": "^1.80.0",
    "@standard-schema/spec": "^1.1.0",
    "@types/node": "^26.2.0",
    "@valibot/to-json-schema": "^1.7.1",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint-plugin-import": "^2.32.0",
    "hono": "^4.13.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.80.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^7.0.2",
    "valibot": "^1.4.2",
    "vitest": "^4.1.11",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "hono": ">=4.10.0"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts}": "pnpm run lint",
    "*": "oxfmt --no-error-on-unmatched-pattern"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.6.0",
      "onFail": "download"
    }
  }
}
