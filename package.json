{
  "name": "@kamaalio/hono-standard-openapi",
  "version": "0.0.1",
  "description": "Generate OpenAPI documents from any Standard Schema library, for Hono.",
  "keywords": [
    "hono",
    "json-schema",
    "openapi",
    "standard-schema",
    "validator"
  ],
  "license": "MIT",
  "author": "",
  "repository": {
    "type": "git",
    "url": "https://github.com/kamaal111/hono-standard-openapi"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "compile": "tsc -p tsconfig.build.json",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "prepare": "husky",
    "release": "sh scripts/publish.sh",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/standard-validator": "^0.4.0",
    "openapi3-ts": "^4.6.1"
  },
  "devDependencies": {
    "@kamaal111/kamaal-quality-config": "^0.3.0",
    "@standard-schema/spec": "^1.1.0",
    "@types/node": "^26.6.4",
    "@valibot/to-json-schema": "^1.8.0",
    "@vinejs/vine": "^4.4.0",
    "@vitest/coverage-v8": "^5.0.3",
    "arktype": "^2.2.7",
    "hono": "^4.13.13",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2003",
    "sury": "^11.0.0",
    "typescript": "^7.0.2",
    "valibot": "^1.5.0",
    "vitest": "^5.0.3",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "hono": ">=4.11.2"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts}": "pnpm run lint",
    "*": "oxfmt --no-error-on-unmatched-pattern"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12.9.1",
      "onFail": "download"
    }
  }
}
